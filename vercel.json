{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "functions": {
    "external": {
      "nodejs": ["fs", "path", "url", "http", "https", "stream", "zlib"]
    }
  },
  "env": {
    "NODE_VERSION": "18"
  }
}